{
  "name": "femforge-docs",
  "compatibility_date": "2026-10-12",
  "assets": { "directory": "./site", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "docs.femforge.io", "custom_domain": true }],
  "env": {
    "next": {
      "name": "femforge-docs-next",
      "routes": [{ "pattern": "next.docs.femforge.io", "custom_domain": true }],
    },
  },
}
