#!/usr/bin/env bash
# Runs the truncation check, the basedpyright gate and ruff before each commit; the Quality workflow adds pytest.
# Enable once per clone, together with the commit-msg hook: git config core.hooksPath .githooks
set -euo pipefail

uv run --no-sync python .githooks/check_truncation.py

uv run --no-sync basedpyright --warnings
uv run --no-sync ruff check src packages scripts examples
uv run --no-sync ruff format --check src packages scripts examples
