"""RcaViewAdapter: the server-side handler behind a RemoteControlledArea."""

from collections.abc import Mapping

from trame_rca.schedulers import RcaRenderSchedulerProtocol

class RcaViewAdapter:
    area_name: str
    def __init__(self, window: object, name: str, *, scheduler: RcaRenderSchedulerProtocol | None = ..., do_schedule_render_on_interaction: bool = ..., **_: object) -> None: ...
    @property
    def target_fps(self) -> float: ...
    @target_fps.setter
    def target_fps(self, value: float) -> None: ...
    @property
    def max_pixel_count(self) -> int: ...
    @max_pixel_count.setter
    def max_pixel_count(self, value: int) -> None: ...
    @property
    def image_size(self) -> tuple[int, int]: ...
    @property
    def scale(self) -> float: ...
    @scale.setter
    def scale(self, value: float) -> None: ...
    def update_quality(self, interactive: int = ..., still: int = ...) -> None: ...
    def update_size(self, origin: object, size: Mapping[str, object]) -> None: ...
    def on_interaction(self, origin: object, event: Mapping[str, object]) -> None: ...
    def do_discard_extra_release_event(self, event: Mapping[str, object]) -> bool: ...
    def schedule_render(self) -> None: ...
    def update(self) -> None: ...
    def reset(self) -> None: ...
    async def close(self) -> None: ...
