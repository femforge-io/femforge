"""The render schedulers behind an RcaViewAdapter."""

from collections.abc import Callable
from concurrent.futures import Executor
from typing import Protocol

from trame_rca.rca import RemoteControlledAreaProtocol

type PushCallback = Callable[[bytes, dict[str, object]], None]

class RcaRenderSchedulerProtocol(Protocol):
    @property
    def rca(self) -> RemoteControlledAreaProtocol: ...
    @property
    def target_fps(self) -> float: ...
    @target_fps.setter
    def target_fps(self, value: float) -> None: ...
    def set_push_callback(self, callback: PushCallback) -> None: ...
    def schedule_render(self) -> None: ...
    def reset(self) -> None: ...
    async def close(self) -> None: ...

class RcaImageRenderScheduler:
    def __init__(
        self,
        window: object,
        *,
        push_callback: PushCallback | None = ...,
        encode_pool: Executor | None = ...,
        target_fps: float = ...,
        interactive_quality: int = ...,
        still_quality: int = ...,
        rca_encoder: str = ...,
    ) -> None: ...
    @property
    def rca(self) -> RemoteControlledAreaProtocol: ...
    @property
    def target_fps(self) -> float: ...
    @target_fps.setter
    def target_fps(self, value: float) -> None: ...
    def update_quality(self, interactive: int, still: int) -> None: ...
    def set_push_callback(self, callback: PushCallback) -> None: ...
    def schedule_render(self) -> None: ...
    def reset(self) -> None: ...
    async def close(self) -> None: ...
