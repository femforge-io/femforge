"""The trame Controller: named function slots the client triggers and the server life-cycle hooks."""

from collections.abc import Callable

type Handler = Callable[..., object]

class ControllerFunction:
    def __call__(self, *args: object, **kwargs: object) -> object: ...
    def add(self, func: Handler) -> Handler: ...
    def once(self, func: Handler) -> Handler: ...
    def add_task(self, func: Handler) -> Handler: ...
    def discard(self, func: Handler) -> None: ...
    def remove(self, func: Handler) -> None: ...
    def clear(self, set_only: bool = ...) -> None: ...
    def exists(self) -> bool: ...

class Controller:
    _triggers_fn2name: dict[Handler, str]
    def trigger[F: Handler](self, name: str) -> Callable[[F], F]: ...
    def trigger_name(self, fn: Handler) -> str: ...
    def trigger_fn(self, name: str) -> Handler | None: ...
    def trigger_unregister(self, fn_or_name: object) -> None: ...
    def add[F: Handler](self, name: str, clear: bool = ...) -> Callable[[F], F]: ...
    def once[F: Handler](self, name: str) -> Callable[[F], F]: ...
    def add_task[F: Handler](self, name: str, clear: bool = ...) -> Callable[[F], F]: ...
    def set[F: Handler](self, name: str, clear: bool = ...) -> Callable[[F], F]: ...
    def __getattr__(self, name: str) -> ControllerFunction: ...
    def __setattr__(self, name: str, func: Handler) -> None: ...
    def __getitem__(self, name: str) -> ControllerFunction: ...
    def __setitem__(self, name: str, func: Handler) -> None: ...
