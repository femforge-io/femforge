"""The shared trame State: a mapping of client-visible variables with change callbacks and a batching context."""

from collections.abc import Callable, Mapping
from typing import Self

class State:
    _change_callbacks: dict[str, list[tuple[Callable[..., object], object]]]
    def __getitem__(self, key: str) -> object: ...
    def __setitem__(self, key: str, value: object) -> None: ...
    def __getattr__(self, key: str) -> object: ...
    def __setattr__(self, key: str, value: object) -> None: ...
    def __contains__(self, key: str) -> bool: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...
    def has(self, key: str) -> bool: ...
    def setdefault(self, key: str, value: object) -> object: ...
    def update(self, _dict: Mapping[str, object]) -> None: ...
    def flush(self) -> None: ...
    def ready(self) -> None: ...
    def dirty(self, *names: str) -> None: ...
    def to_dict(self) -> dict[str, object]: ...
    def change[F: Callable[..., object]](self, *names: str) -> Callable[[F], F]: ...
    @property
    def translator(self) -> object: ...
