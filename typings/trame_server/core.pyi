"""The trame Server: state, controller, static asset modules, JS calls and the start/stop lifecycle."""

from argparse import ArgumentParser
from collections.abc import Awaitable, Callable, Mapping
from types import ModuleType
from typing import Literal

from trame_server.controller import Controller
from trame_server.state import State

type ClientType = Literal["vue2", "vue3", "react"]
type ExecMode = Literal["main", "desktop", "task", "coroutine"]

class Server:
    hot_reload: bool
    serve: dict[str, str]
    def __init__(self, name: str = ..., vn_constructor: object = ..., translator: object = ..., parent_server: Server | None = ..., **options: object) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def state(self) -> State: ...
    @property
    def controller(self) -> Controller: ...
    @property
    def context(self) -> State: ...
    @property
    def client_type(self) -> ClientType: ...
    @client_type.setter
    def client_type(self, value: ClientType) -> None: ...
    @property
    def port(self) -> int: ...
    @property
    def running(self) -> bool: ...
    @property
    def ready(self) -> Awaitable[bool]: ...
    @property
    def protocol(self) -> object | None: ...
    @property
    def cli(self) -> ArgumentParser: ...
    @property
    def root_server(self) -> Server: ...
    def enable_module(self, module: Mapping[str, object] | ModuleType, **kwargs: object) -> bool: ...
    def js_call(self, ref: str | None = ..., method: str | None = ..., *args: object) -> None: ...
    def trigger[F: Callable[..., object]](self, name: str) -> Callable[[F], F]: ...
    def trigger_name(self, fn: Callable[..., object]) -> str: ...
    def start(
        self,
        port: int | None = ...,
        thread: bool = ...,
        open_browser: bool | None = ...,
        show_connection_info: bool = ...,
        disable_logging: bool = ...,
        backend: str | None = ...,
        follow_symlinks: bool | None = ...,
        exec_mode: ExecMode = ...,
        timeout: int | None = ...,
        host: str | None = ...,
        **kwargs: object,
    ) -> Awaitable[object] | None: ...
    async def stop(self) -> None: ...
