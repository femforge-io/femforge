"""AbstractElement, the base of every trame widget: attributes, events, children and the with-block nesting."""

from collections.abc import Sequence
from typing import Self

from trame_server import Controller, Server, State

class AbstractElement:
    _attr_names: list[str | tuple[str, str]]
    _event_names: list[str | tuple[str, str]]
    _elem_name: str
    _id: int
    def __init__(self, _elem_name: str, children: object = ..., **kwargs: object) -> None: ...
    @property
    def server(self) -> Server: ...
    @property
    def state(self) -> State: ...
    @property
    def ctrl(self) -> Controller: ...
    @property
    def html(self) -> object: ...
    @property
    def children(self) -> list[object]: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...
    def __getattr__(self, name: str) -> object: ...
    def __setattr__(self, name: str, value: object) -> None: ...
    def __getitem__(self, name: str) -> object: ...
    def __setitem__(self, name: str, value: object) -> None: ...
    def add_child(self, child: object) -> None: ...
    def add_children(self, children: Sequence[object]) -> None: ...
    def clear(self) -> None: ...
    def hide(self) -> None: ...
    def set_text(self, value: str) -> None: ...
    def attrs(self, *names: str | tuple[str, str]) -> Self: ...
    def events(self, *names: str | tuple[str, str]) -> Self: ...

class Template(AbstractElement):
    def __init__(self, children: object = ..., **kwargs: object) -> None: ...
