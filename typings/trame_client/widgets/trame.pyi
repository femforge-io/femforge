"""trame's own client helpers: inline styles, JS evaluation and template hosts."""

from trame_client.widgets.core import AbstractElement

class Style(AbstractElement):
    def __init__(self, css_content: str | None = ..., **kwargs: object) -> None: ...
    def update(self, css_content: str) -> None: ...
    @property
    def var_name(self) -> str: ...

class Script(AbstractElement):
    def __init__(self, script_content: str | None = ..., **kwargs: object) -> None: ...

class JSEval(AbstractElement):
    def __init__(self, children: object = ..., **kwargs: object) -> None: ...
    def exec(self, event: object = ...) -> None: ...

class LifeCycleMonitor(AbstractElement):
    def __init__(self, children: object = ..., **kwargs: object) -> None: ...

class ServerTemplate(AbstractElement):
    def __init__(self, children: object = ..., **kwargs: object) -> None: ...

class SizeObserver(AbstractElement):
    def __init__(self, _name: str, **kwargs: object) -> None: ...
