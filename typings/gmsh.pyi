"""Local type stub for the parts of the ``gmsh`` Python API this project uses.

``gmsh`` ships as a single generated ``gmsh.py`` with no type information, so its
members resolve to Unknown under basedpyright. This stub SEALS only the surface
we actually call; adding a new gmsh call means adding its signature here.

The real API exposes ``model``, ``option`` (and the nested ``model.occ`` /
``model.mesh``) as singleton-like namespaces, so we model them as module-level
instances of private classes to preserve the ``gmsh.model.occ.synchronize()``
attribute-access shape.
"""

from collections.abc import Sequence

__version__: str

# -- top-level lifecycle ----------------------------------------------------
def initialize(
    argv: Sequence[str] = ...,
    readConfigFiles: bool = ...,
    run: bool = ...,
    interruptible: bool = ...,
) -> None: ...
def isInitialized() -> bool: ...
def clear() -> None: ...
def finalize() -> None: ...
def write(fileName: str) -> None: ...

# -- gmsh.option ------------------------------------------------------------
class _Option:
    def setNumber(self, name: str, value: float) -> None: ...
    def setString(self, name: str, value: str) -> None: ...

option: _Option

# -- gmsh.model.occ ---------------------------------------------------------
class _OCC:
    def importShapes(self, fileName: str, highestDimOnly: bool = ..., format: str = ...) -> list[tuple[int, int]]: ...
    def synchronize(self) -> None: ...
    def getCenterOfMass(self, dim: int, tag: int) -> tuple[float, float, float]: ...
    def getMass(self, dim: int, tag: int) -> float: ...
    def addBox(self, x: float, y: float, z: float, dx: float, dy: float, dz: float, tag: int = ...) -> int: ...
    def fragment(
        self,
        objectDimTags: Sequence[tuple[int, int]],
        toolDimTags: Sequence[tuple[int, int]],
        tag: int = ...,
        removeObject: bool = ...,
        removeTool: bool = ...,
    ) -> tuple[list[tuple[int, int]], list[list[tuple[int, int]]]]: ...
    def dilate(self, dimTags: Sequence[tuple[int, int]], center_x: float, center_y: float, center_z: float, scale_x: float, scale_y: float, scale_z: float) -> None: ...

# -- gmsh.model.mesh --------------------------------------------------------
class _Mesh:
    def generate(self, dim: int = ...) -> None: ...
    def getElements(self, dim: int = ..., tag: int = ...) -> tuple[list[int], list[list[int]], list[list[int]]]: ...
    def setSize(self, dimTags: Sequence[tuple[int, int]], size: float) -> None: ...

# -- gmsh.model -------------------------------------------------------------
class _Model:
    occ: _OCC
    mesh: _Mesh
    def getEntities(self, dim: int = ...) -> list[tuple[int, int]]: ...
    def getBoundary(
        self,
        dimTags: Sequence[tuple[int, int]],
        combined: bool = ...,
        oriented: bool = ...,
        recursive: bool = ...,
    ) -> list[tuple[int, int]]: ...
    def getAdjacencies(self, dim: int, tag: int) -> tuple[Sequence[int], Sequence[int]]: ...
    def getBoundingBox(self, dim: int, tag: int) -> tuple[float, float, float, float, float, float]: ...
    def addPhysicalGroup(self, dim: int, tags: Sequence[int], tag: int = ..., name: str = ...) -> int: ...
    def setPhysicalName(self, dim: int, tag: int, name: str) -> None: ...
    def getEntityName(self, dim: int, tag: int) -> str: ...
    def setEntityName(self, dim: int, tag: int, name: str) -> None: ...
    def getValue(self, dim: int, tag: int, parametricCoord: Sequence[float]) -> Sequence[float]: ...
    def getParametrizationBounds(self, dim: int, tag: int) -> tuple[Sequence[float], Sequence[float]]: ...

model: _Model
