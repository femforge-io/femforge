"""get_server plus the TrameComponent and TrameApp bases that bind decorated methods to a server."""

from typing import Literal

from trame_server import Controller, Server, State

def get_server(name: str | Server | None = ..., create_if_missing: bool = ..., client_type: Literal["vue2", "vue3", "react"] | None = ..., **kwargs: object) -> Server: ...

class TrameComponent:
    def __init__(self, server: Server, ctx_name: str | None = ..., **_: object) -> None: ...
    @property
    def server(self) -> Server: ...
    @property
    def state(self) -> State: ...
    @property
    def ctrl(self) -> Controller: ...
    @property
    def ctx(self) -> State: ...
    def _bind_annotated_methods(self) -> None: ...
    def _unbind_annotated_methods(self) -> None: ...

class TrameApp(TrameComponent):
    def __init__(self, server: str | Server | None = ..., client_type: Literal["vue2", "vue3", "react"] = ..., ctx_name: str | None = ..., **_: object) -> None: ...
