"""LocalView (VTK.wasm) re-exported from trame_vtklocal."""

from collections.abc import Mapping

from trame_client.widgets.core import AbstractElement
from trame_server import Server
from vtkmodules.vtkSerializationManager import vtkObjectManager

class LocalView(AbstractElement):
    def __init__(self, render_window: object, throttle_rate: int = ..., **kwargs: object) -> None: ...
    @property
    def ref_name(self) -> str: ...
    @property
    def object_manager(self) -> vtkObjectManager: ...
    def update(self, push_camera: bool = ..., **options: object) -> None: ...
    def render(self) -> None: ...
    def eval(self, state_mapping: Mapping[str, object]) -> None: ...
    async def invoke(self, vtk_obj: object, method: str, *args: object, unwrap_vtk_object: bool = ...) -> object: ...
    def reset_camera(self, renderer_or_render_window: object = ...) -> None: ...
    def register_vtk_object(self, vtk_instance: object) -> int: ...
    def unregister_vtk_object(self, vtk_instance: object) -> bool: ...
    def get_wasm_id(self, vtk_object: object) -> int: ...

def initialize(server: Server) -> None: ...
