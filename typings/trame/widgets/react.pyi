"""React bindings for client_type react: Bind, Callback, If, For and Slot."""

from collections.abc import Callable, Sequence
from typing import Self

from trame_server import Server

class Bind:
    js_expression: str
    state_defaults: dict[str, object]
    def __init__(self, js_expression: str, **state_defaults: object) -> None: ...
    def to_json(self, server: Server) -> dict[str, object]: ...

class Callback:
    value: str | Callable[..., object]
    args: str | None
    kwargs: str | None
    modifiers: list[str]
    def __init__(
        self,
        value: str | Callable[..., object],
        args: str | None = ...,
        kwargs: str | None = ...,
        modifiers: Sequence[str] | None = ...,
    ) -> None: ...
    def to_json(self, server: Server) -> dict[str, object]: ...

class If:
    def __init__(self, value: str | Bind, **kwargs: object) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...

class For:
    def __init__(self, items: str | Bind, name: str, **kwargs: object) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...

class Slot:
    params: list[str]
    def __init__(self, params: Sequence[str] | None = ..., connect_parent: bool = ..., **kwargs: object) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...
    def to_json(self, server: Server) -> dict[str, object]: ...
